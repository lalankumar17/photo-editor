      background: transparent !important;
      z-index: 5 !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-playhead::before {
      top: 72px !important;
      width: 10px !important;
      height: 18px !important;
      background: #111827 !important;
      border-radius: 3px !important;
      z-index: 2 !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-playhead::after {
      content: "" !important;
      position: absolute !important;
