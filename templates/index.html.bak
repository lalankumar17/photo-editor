    const exportResultEdit = document.getElementById('exportResultEdit');
    const veResetBtn    = document.getElementById('veResetBtn');
    const mePanel       = document.getElementById('musicEditorPanel');
    const meCloseBtn    = document.getElementById('meCloseBtn');
    const meDropZone    = document.getElementById('meDropZone');
    const meFileInput   = document.getElementById('meFileInput');
    const meBrowseLink  = document.getElementById('meBrowseLink');
    const meControls    = document.getElementById('meControls');
    const meUploadProgress = document.getElementById('meUploadProgress');
    const meUploadFileName = document.getElementById('meUploadFileName');
    const meUploadPercent = document.getElementById('meUploadPercent');
    const meUploadBar = document.getElementById('meUploadBar');
    const meAudioPreview= document.getElementById('meAudioPreview');
