    }
    html.dark .ve-timeline-top {
      background: #0d1117 !important;
      border-bottom: 1px solid #21262d !important;
    }
    html.dark .ve-tool-btn, html.dark .ve-transport-btn {
      color: #8b949e !important;
    }
    html.dark .ve-tool-btn:hover, html.dark .ve-transport-btn:hover, html.dark .ve-tool-btn.active {
      background: #21262d !important;
      color: #ffffff !important;
    }
    html.dark .ve-split-label {
      background: #21262d !important;
      color: #c9d1d9 !important;
    }
    html.dark .ve-transport-btn.play {
      background: #1f6feb !important;
      color: #ffffff !important;
    }
    html.dark .ve-transport-btn.play:hover {
      background: #388bfd !important;
    }
    html.dark .ve-time-readout {
      color: #8b949e !important;
    }
    html.dark .ve-time-readout strong {
      color: #58a6ff !important;
    }
    html.dark .ve-ruler {
      border-bottom: 1px solid #21262d !important;
    }
    html.dark .ve-ruler-tick {
      background: #30363d !important;
    }
    html.dark .ve-ruler-tick span {
      color: #8b949e !important;
    }
    html.dark .ve-empty-timeline-message {
      color: #8b949e !important;
    }
    html.dark .ve-playhead {
      background: #58a6ff !important;
    }
    html.dark .ve-playhead::before {
      background: #58a6ff !important;
    }
    html.dark .ve-playhead-time {
      color: #58a6ff !important;
    }
    html.dark .ve-control-head {
      color: #8b949e !important;
    }
    html.dark .ve-control-value {
      color: #ffffff !important;
    }
    html.dark .ve-dark-range {
      background: #30363d !important;
    }
    html.dark .ve-dark-range::-webkit-slider-thumb {
      background: #ffffff !important;
      border: 1.5px solid #58a6ff !important;
    }
    html.dark .ve-reset-dark {
      background: #161b22 !important;
      color: #c9d1d9 !important;
      border: 1px solid #21262d !important;
    }
    html.dark .ve-reset-dark:hover {
      background: #21262d !important;
    }
    html.dark .ve-toggle-track {
      background: #30363d !important;
    }
    html.dark .ve-thumb-frame {
      background:
        linear-gradient(135deg, rgba(56,139,253,0.25), rgba(46,160,67,0.15)),
        repeating-linear-gradient(90deg, rgba(255,255,255,0.06) 0 1px, transparent 1px 28px),
        #21262d !important;
      border-right: 1px solid rgba(255,255,255,0.15) !important;
    }

    /* Settings Mode Dark Override */
    html.dark #videoEditorPanel.ve-settings-mode .ve-workspace {
      background: #161b22 !important;
      color: #c9d1d9 !important;
      border-color: #21262d !important;
    }
    html.dark #videoEditorPanel.ve-settings-mode .ve-workspace-top {
      background: #161b22 !important;
      border-bottom: 1px solid #21262d !important;
    }
    html.dark #videoEditorPanel.ve-settings-mode .ve-date {
      color: #ffffff !important;
    }
    html.dark #videoEditorPanel.ve-settings-mode .ve-editor-shell {
      border: 1px solid #21262d !important;
      background: #0d1117 !important;
      color: #c9d1d9 !important;
    }
    html.dark #videoEditorPanel.ve-settings-mode .ve-resize-title,
    html.dark #videoEditorPanel.ve-settings-mode .ve-background-title {
      color: #8b949e !important;
    }

    /* Reference-style white timeline */
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline {
      min-height: 302px !important;
      background: #ffffff !important;
      border: 1px solid #e5e7eb !important;
      border-right: 0 !important;
      border-bottom: 0 !important;
      border-left: 0 !important;
      border-radius: 0 !important;
      color: #64748b !important;
      overflow: hidden !important;
    }
    #videoEditorPanel:fullscreen {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #101116;
    }
    #videoEditorPanel:fullscreen .ve-workspace {
      width: 100%;
      height: 100%;
      min-height: 100vh;
      background: #101116 !important;
      border: 0 !important;
      border-radius: 0 !important;
      overflow: hidden !important;
    }
    #videoEditorPanel:fullscreen .ve-workspace-top,
    #videoEditorPanel:fullscreen .ve-left-pane,
    #videoEditorPanel:fullscreen .ve-timeline {
      display: none !important;
    }
    #videoEditorPanel:fullscreen .ve-workspace-main {
      width: 100% !important;
      height: 100% !important;
      min-height: 100vh !important;
      display: block !important;
      padding: 0 !important;
    }
    #videoEditorPanel:fullscreen .ve-stage-pane {
      width: 100% !important;
      height: 100vh !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: #101116 !important;
      border: 0 !important;
      border-radius: 0 !important;
      overflow: hidden !important;
    }
    #videoEditorPanel:fullscreen .ve-stage-frame {
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      aspect-ratio: auto !important;
      background: #101116 !important;
      border: 0 !important;
      border-radius: 0 !important;
      overflow: hidden !important;
      position: relative;
    }
    #videoEditorPanel:fullscreen .ve-preview-frame {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
      aspect-ratio: auto !important;
      background: #101116 !important;
      border-radius: 0 !important;
    }
    #videoEditorPanel:fullscreen #veVideoPreview,
    #videoEditorPanel:fullscreen #veImagePreview {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      background: #101116 !important;
    }
    #videoEditorPanel:fullscreen .ve-crop-guide {
      display: none !important;
    }
    .ve-fullscreen-controls {
      display: none;
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-controls {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 82px;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 18px;
      padding: 18px 24px 14px;
      background: linear-gradient(180deg, rgba(16,17,22,0), rgba(16,17,22,0.92) 42%, rgba(16,17,22,0.98));
      color: #d1d5db;
      z-index: 30;
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-progress {
      position: absolute;
      left: 24px;
      right: 24px;
      top: 16px;
      height: 2px;
      background: rgba(255,255,255,0.28);
      cursor: pointer;
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-progress-fill {
      width: 0%;
      height: 100%;
      background: rgba(255,255,255,0.72);
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-time {
      align-self: end;
      color: rgba(255,255,255,0.78);
      font-size: 14px;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-time span:first-child {
      color: rgba(255,255,255,0.92);
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-play,
    #videoEditorPanel:fullscreen .ve-fullscreen-exit {
      width: 42px;
      height: 42px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 7px;
      background: transparent;
      color: rgba(255,255,255,0.86);
      cursor: pointer;
      font-size: 30px;
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-exit {
      justify-self: end;
      align-self: end;
      font-size: 28px;
    }
    #videoEditorPanel:fullscreen .ve-fullscreen-play:hover,
    #videoEditorPanel:fullscreen .ve-fullscreen-exit:hover {
      background: rgba(255,255,255,0.1);
      color: #ffffff;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline-top {
      min-height: 44px !important;
      display: grid !important;
      grid-template-columns: auto 1fr auto !important;
      gap: 14px !important;
      padding: 4px 14px !important;
      background: #ffffff !important;
      border-bottom: 1px solid #e5e7eb !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline-tools {
      gap: 4px !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-tool-btn,
    #videoEditorPanel:not(.ve-settings-mode) .ve-transport-btn {
      width: 32px !important;
      height: 32px !important;
      color: #334155 !important;
      background: transparent !important;
      border-radius: 7px !important;
      font-size: 19px !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-tool-btn:hover,
    #videoEditorPanel:not(.ve-settings-mode) .ve-transport-btn:hover,
    #videoEditorPanel:not(.ve-settings-mode) .ve-tool-btn.active {
      background: #f8fafc !important;
      color: #0f172a !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-tool-btn:disabled {
      opacity: 0.35 !important;
      cursor: default !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-transport {
      justify-content: center !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-transport-btn.play {
      width: 38px !important;
      height: 38px !important;
      background: #3b82f6 !important;
      color: #ffffff !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline-zoom {
      gap: 6px !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline-zoom .ve-tool-btn {
      position: relative;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn {
      width: 38px !important;
      height: 34px !important;
      background: #f8fafc !important;
      border: 1px solid #e5e7eb !important;
      color: #0f172a !important;
      box-shadow: none !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-icon {
      width: 20px;
      height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      color: currentColor;
      line-height: 1;
      font-size: 16px;
      font-weight: 700;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-icon i {
      display: block;
      line-height: 1;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-icon i + i {
      margin-left: -3px;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:hover,
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn.active {
      background: #eef2f7 !important;
      border-color: #dbe3ed !important;
      box-shadow: none !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn::before {
      content: attr(data-tooltip);
      position: absolute;
      left: 50%;
      bottom: calc(100% + 11px);
      transform: translateX(-50%) translateY(2px);
      height: 32px;
      display: flex;
      align-items: center;
      padding: 0 12px;
      border-radius: 999px;
      background: #ffffff;
      color: #111827;
      border: 1px solid #e5e7eb;
      box-shadow: none;
      font-size: 13px;
      font-weight: 800;
      line-height: 1;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.14s ease, transform 0.14s ease;
      z-index: 20;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: calc(100% + 5px);
      width: 10px;
      height: 10px;
      background: #ffffff;
      border-right: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
      transform: translateX(-50%) rotate(45deg);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.14s ease;
      z-index: 19;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:hover::before,
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:focus-visible::before,
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:hover::after,
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:focus-visible::after {
      opacity: 1;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:hover::before,
    #videoEditorPanel:not(.ve-settings-mode) .ve-fit-screen-btn:focus-visible::before {
      transform: translateX(-50%) translateY(0);
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline-body {
      min-height: 258px !important;
      padding: 0 0 16px !important;
      background: #ffffff !important;
      overflow-y: hidden !important;
      scrollbar-width: none !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-timeline-body::-webkit-scrollbar {
      display: none !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-ruler {
      height: 48px !important;
      min-width: 720px !important;
      border-bottom: 1px solid #cbd5e1 !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-ruler-tick {
      height: 10px !important;
      background: #111827 !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-ruler-tick span {
      top: 18px !important;
      color: #111827 !important;
      font-size: 13px !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-track-zone {
      height: 196px !important;
      min-width: 720px !important;
      padding-top: 0 !important;
      background:
        linear-gradient(#ffffff 0 72px, #f8fafc 72px 146px, #ffffff 146px 100%) !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-segments-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-trim-clip {
      top: 80px !important;
      height: 66px !important;
      min-width: 36px !important;
      border: 4px solid #facc15 !important;
      border-left-width: 10px !important;
      border-right-width: 10px !important;
      border-radius: 8px !important;
      background: #41607f !important;
      box-shadow: none !important;
      pointer-events: auto;
      transition: top 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-trim-clip.selected {
      box-shadow: inset 0 0 0 1px rgba(15,23,42,0.18), 0 0 0 1px #fbbf24 !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-segment-ghost {
      border-color: #facc15 !important;
      opacity: 0.72;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-segment-ghost:hover {
      opacity: 0.92;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-thumb-frame {
      min-width: 64px !important;
      background:
        linear-gradient(135deg, rgba(37,99,235,0.32), rgba(20,184,166,0.2)),
        repeating-linear-gradient(90deg, rgba(255,255,255,0.13) 0 1px, transparent 1px 34px),
        #476a84 !important;
      border-right: 1px solid rgba(255,255,255,0.22) !important;
    }
    #videoEditorPanel:not(.ve-settings-mode) .ve-trim-handle::after {
      background: rgba(15,23,42,0.58) !important;
