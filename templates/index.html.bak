    }
    html.dark .ve-mode-btn i {
      color: #8b949e !important;
    }
    html.dark .ve-mode-btn.active, html.dark .ve-icon-tool.active, html.dark .ve-speed-preset.active,
    html.dark .ve-mode-btn:hover, html.dark .ve-icon-tool:hover, html.dark .ve-speed-preset:hover {
      background: rgba(56,139,253,0.1) !important;
      border-color: #58a6ff !important;
      color: #58a6ff !important;
    }
    html.dark .ve-mode-btn.active i, html.dark .ve-mode-btn:hover i {
      color: #58a6ff !important;
    }
    html.dark .ve-dark-subtitle {
      color: #c9d1d9 !important;
      border-top: 1px solid #21262d !important;
    }
    html.dark .ve-stepper {
      background: #161b22 !important;
      border: 1px solid #21262d !important;
    }
    html.dark .ve-stepper button {
      color: #8b949e !important;
    }
    html.dark .ve-stepper button:hover {
      background: #21262d !important;
    }
    html.dark .ve-stepper span {
      color: #ffffff !important;
    }
    html.dark .ve-timeline {
      background: #161b22 !important;
      border-top: 1px solid #21262d !important;
