    #videoEditorPanel.ve-settings-mode .ve-track-zone {
      height: 196px !important;
      min-width: 720px !important;
      padding-top: 0 !important;
      background:
        linear-gradient(#ffffff 0 72px, #f8fafc 72px 146px, #ffffff 146px 100%) !important;
    }
    #videoEditorPanel.ve-settings-mode .ve-segments-layer {
      position: absolute;
      inset: 0;
