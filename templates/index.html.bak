<body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-white" oncontextmenu="return false">

  <!-- Navbar -->
  <nav class="sticky top-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md border-b border-gray-300 dark:border-gray-700 transition-colors shadow-sm">
    <div class="container mx-auto px-3 sm:px-6 lg:px-8 flex items-center justify-between h-16 w-full">
        <div class="flex items-center gap-4 min-w-0 flex-1 mr-2">
            <a href="/" class="truncate text-[18px] text-black font-medium dark:text-white cursor-pointer flex items-center gap-2">
              Passport Photo Editor
            </a>
        </div>
        
        <div class="flex items-center gap-2 pr-3 sm:pr-0">
          <button id="themeToggle" class="p-1.5 sm:p-2 text-gray-700 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors focus:outline-none flex items-center justify-center">
            <svg class="w-[22px] h-[22px] sm:w-6 sm:h-6 hidden dark:block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="w-[22px] h-[22px] sm:w-6 sm:h-6 block dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <a href="https://github.com/lalankumar17/photo-editor" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-1.5 sm:p-2 text-gray-700 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors focus:outline-none flex items-center justify-center">
            <i class="ri-github-fill text-[22px] sm:text-2xl leading-none"></i>
          </a>
        </div>
    </div>
  </nav>

  <div class="app-container">
    <!-- Desktop Sidebar -->
    <aside class="w-64 flex-shrink-0 pt-6 pb-4 flex flex-col gap-1 select-none hidden md:flex bg-transparent">
      <!-- Media Shortcut Area -->
      <div class="px-6 mb-4">
        <div class="media-shortcut-wrap">
          <button id="menuMedia" class="media-shortcut" title="Media" type="button">
            <i class="ri-upload-cloud-2-line text-blue-500 dark:text-blue-400" aria-hidden="true"></i>
            <span>Media</span>
          </button>
        </div>
      </div>

      <div class="sidebar-media-kinds" aria-label="Media categories">
        <button type="button" id="menuImages" class="sidebar-item" title="Images">
          <i class="ri-image-line text-blue-500 dark:text-blue-400" aria-hidden="true"></i>
          <span>Images</span>
        </button>
        <button type="button" id="menuMusicEditor" class="sidebar-item" title="Audio">
          <i class="ri-music-2-line text-purple-500 dark:text-purple-400" aria-hidden="true"></i>
          <span>Audio</span>
        </button>
      </div>

      <div class="sidebar-item" id="menuRecord">
        <i class="ri-record-circle-line text-rose-500 dark:text-rose-400"></i>
        <span>Record</span>
      </div>

    </aside>
    <main class="main-content">
      <!-- Mobile View Helpers (horizontal media menu) -->
      <div class="px-2 md:hidden">
        <div class="mobile-sidebar-menu mt-4 mb-4" aria-label="Media categories">
          <button type="button" id="mobileMediaBtn" class="sidebar-item mobile-sidebar-item" title="Media">
            <i class="ri-upload-cloud-2-line text-blue-500 dark:text-blue-400" aria-hidden="true"></i>
            <span>Media</span>
          </button>
          <button type="button" id="tabImages" class="sidebar-item mobile-sidebar-item" title="Images">
            <i class="ri-image-line text-blue-500 dark:text-blue-400" aria-hidden="true"></i>
            <span>Images</span>
          </button>
          <button type="button" id="tabMusicEditor" class="sidebar-item mobile-sidebar-item" title="Audio">
            <i class="ri-music-2-line text-purple-500 dark:text-purple-400" aria-hidden="true"></i>
            <span>Audio</span>
          </button>
          <button type="button" id="tabRecord" class="sidebar-item mobile-sidebar-item" title="Record">
            <i class="ri-record-circle-line text-rose-500 dark:text-rose-400" aria-hidden="true"></i>
            <span>Record</span>
          </button>
        </div>
      </div>
      
  <!-- â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• VIDEO EDITOR PANEL â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
  <!-- ═══════════════════════ VIDEO EDITOR PANEL ═══════════════════════ -->
  <div id="videoEditorPanel" class="hidden">
    <section class="ve-workspace" aria-label="Video editor">

      <button id="veCloseBtn" type="button" class="hidden">Close</button>
      <header class="ve-workspace-top">
        <div id="veCurrentDate" class="ve-date">29 May 2026</div>
        <div class="ve-top-actions">
          <button id="veExportBtn" type="button" class="ve-export-btn" disabled>
            <i class="ri-upload-2-line"></i>
            <span>Export</span>
          </button>
        </div>
      </header>

      <div class="ve-workspace-main">
        <aside class="ve-left-pane">

          <div id="veDropZone" class="ve-upload-card">
            <input type="file" id="veFileInput" accept="image/*,video/*" multiple class="hidden">
            <div class="ve-upload-copy">
              <i class="ri-upload-cloud-2-line"></i>
              <strong id="veBrowseLink">Click to upload</strong>
              <span>or drag &amp; drop an image or video here</span>
            </div>
          </div>

          <div id="veControls" class="hidden">
            <div class="hidden">
              <button id="veChangeVideoBtn" class="ve-btn ve-btn-secondary text-xs">⬆ Change Video</button>
              <span id="veFileName" class="text-xs text-gray-400 truncate self-center"></span>
            </div>

          <div class="ve-editor-shell">
            <div class="ve-tabs" role="tablist" aria-label="Video editing tools">
              <button type="button" class="ve-tab active" data-video-tab="transform">Transform</button>
              <button type="button" class="ve-tab" data-video-tab="adjust">Adjust</button>
              <button type="button" class="ve-tab" data-video-tab="audio">Audio</button>
              <button type="button" class="ve-tab" data-video-tab="speed">Speed</button>
            </div>

            <div class="ve-tab-panel active" data-video-panel="transform">
              <div class="ve-resize-panel">
                <p class="ve-resize-title">Resize</p>
                <button type="button" id="veResizeSelect" class="ve-resize-select" aria-expanded="false" aria-controls="veResizeOptions">
                  <span class="ve-resize-select-main">
                    <i id="veResizeSelectedIcon" class="ri-youtube-fill" aria-hidden="true"></i>
                    <span id="veResizeSelectedName">YouTube</span>
                    <span id="veResizeSelectedRatio" class="ve-resize-ratio">&mdash; 16:9</span>
                  </span>
                  <span class="ve-resize-chevron" aria-hidden="true">
                    <i class="ri-arrow-down-s-line"></i>
                  </span>
                </button>
                <div id="veResizeOptions" class="ve-resize-options hidden" role="listbox" aria-label="Resize presets">
                  <button type="button" class="ve-resize-option active" data-resize-name="YouTube" data-resize-ratio="16:9" data-resize-icon="ri-youtube-fill" data-resize-width="1920" data-resize-height="1080" role="option" aria-selected="true">
                    <span class="ve-resize-option-main"><i class="ri-youtube-fill" aria-hidden="true"></i><span>YouTube <span class="ve-resize-ratio">&mdash; 16:9</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="YouTube Shorts" data-resize-ratio="9:16" data-resize-icon="ri-youtube-fill" data-resize-width="1080" data-resize-height="1920" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-youtube-fill" aria-hidden="true"></i><span>YouTube Shorts <span class="ve-resize-ratio">&mdash; 9:16</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="TikTok" data-resize-ratio="9:16" data-resize-icon="ri-tiktok-fill" data-resize-width="1080" data-resize-height="1920" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-tiktok-fill" aria-hidden="true"></i><span>TikTok <span class="ve-resize-ratio">&mdash; 9:16</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="Instagram Story &amp; Reels" data-resize-ratio="9:16" data-resize-icon="ri-instagram-line" data-resize-width="1080" data-resize-height="1920" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-instagram-line" aria-hidden="true"></i><span>Instagram Story &amp; Reels <span class="ve-resize-ratio">&mdash; 9:16</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="Instagram Post Square" data-resize-ratio="1:1" data-resize-icon="ri-instagram-line" data-resize-width="1080" data-resize-height="1080" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-instagram-line" aria-hidden="true"></i><span>Instagram Post Square <span class="ve-resize-ratio">&mdash; 1:1</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="Instagram Post" data-resize-ratio="4:5" data-resize-icon="ri-instagram-line" data-resize-width="1080" data-resize-height="1350" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-instagram-line" aria-hidden="true"></i><span>Instagram Post <span class="ve-resize-ratio">&mdash; 4:5</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="Snapchat Story" data-resize-ratio="9:16" data-resize-icon="ri-snapchat-fill" data-resize-width="1080" data-resize-height="1920" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-snapchat-fill" aria-hidden="true"></i><span>Snapchat Story <span class="ve-resize-ratio">&mdash; 9:16</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                  <button type="button" class="ve-resize-option" data-resize-name="Facebook Story" data-resize-ratio="9:16" data-resize-icon="ri-facebook-circle-fill" data-resize-width="1080" data-resize-height="1920" role="option" aria-selected="false">
                    <span class="ve-resize-option-main"><i class="ri-facebook-circle-fill" aria-hidden="true"></i><span>Facebook Story <span class="ve-resize-ratio">&mdash; 9:16</span></span></span>
                    <i class="ri-check-line ve-resize-option-check" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="ve-background-panel" aria-label="Background">
                  <p class="ve-background-title">Background</p>
                  <div class="ve-background-swatches">
                    <button type="button" class="ve-bg-swatch" data-video-bg="linear-gradient(180deg,#c000c7 0%,#f6d12f 100%)" aria-label="Rainbow gradient" style="background: conic-gradient(#ef4444,#f59e0b,#22c55e,#06b6d4,#2563eb,#a855f7,#ef4444);"></button>
                    <button type="button" class="ve-bg-swatch active" data-video-bg="#000000" aria-label="Black background" style="background:#000000;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#ffffff" aria-label="White background" style="background:#ffffff;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#ef4444" aria-label="Red background" style="background:#ef4444;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#fb923c" aria-label="Orange background" style="background:#fb923c;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#fbbf24" aria-label="Yellow background" style="background:#fbbf24;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#22c55e" aria-label="Green background" style="background:#22c55e;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#2f80ed" aria-label="Blue background" style="background:#2f80ed;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#8b5cf6" aria-label="Purple background" style="background:#8b5cf6;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#db2777" aria-label="Pink background" style="background:#db2777;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#9ca3af" aria-label="Gray background" style="background:#9ca3af;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#c9b08f" aria-label="Tan background" style="background:#c9b08f;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#b7e4c7" aria-label="Mint background" style="background:#b7e4c7;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#a7c7e7" aria-label="Light blue background" style="background:#a7c7e7;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="#e6a8bd" aria-label="Rose background" style="background:#e6a8bd;"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="linear-gradient(180deg,#7c3aed 0%,#06b6d4 100%)" aria-label="Purple cyan gradient" style="background:linear-gradient(180deg,#7c3aed,#06b6d4);"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="linear-gradient(180deg,#db2777 0%,#facc15 100%)" aria-label="Pink yellow gradient" style="background:linear-gradient(180deg,#db2777,#facc15);"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="linear-gradient(180deg,#9333ea 0%,#2563eb 100%)" aria-label="Purple blue gradient" style="background:linear-gradient(180deg,#9333ea,#2563eb);"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="linear-gradient(180deg,#bbf7d0 0%,#67e8f9 100%)" aria-label="Mint aqua gradient" style="background:linear-gradient(180deg,#bbf7d0,#67e8f9);"></button>
                    <button type="button" class="ve-bg-swatch" data-video-bg="linear-gradient(180deg,#a7f3d0 0%,#f9a8d4 100%)" aria-label="Mint pink gradient" style="background:linear-gradient(180deg,#a7f3d0,#f9a8d4);"></button>
                  </div>
                </div>
              </div>
              <p class="ve-dark-subtitle">Flip &amp; Rotate</p>
              <div class="ve-transform-row">
                <button type="button" id="veFlipHorizontal" class="ve-icon-tool" title="Flip horizontal"><i class="ri-flip-horizontal-line"></i></button>
                <button type="button" id="veFlipVertical" class="ve-icon-tool" title="Flip vertical"><i class="ri-flip-vertical-line"></i></button>
                <div class="ve-stepper">
                  <button type="button" id="veRotateMinus" aria-label="Rotate left">-</button>
                  <span id="veRotateValue">0°</span>
                  <button type="button" id="veRotatePlus" aria-label="Rotate right">+</button>
                </div>
                <button type="button" class="ve-icon-tool" data-fit-mode="crop" title="Crop"><i class="ri-crop-line"></i></button>
                <button type="button" id="veAddMediaBtn" class="ve-icon-tool ve-add-media-tool" title="Add media"><i class="ri-add-line"></i><span>Media</span></button>
              </div>
            </div>

            <div class="ve-tab-panel" data-video-panel="adjust">
              <div class="ve-control-stack">
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Opacity</span><span id="veOpacityVal" class="ve-control-value">100%</span></div>
                  <input type="range" id="veOpacity" class="ve-dark-range" min="0" max="100" step="1" value="100">
                </div>
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Brightness</span><span id="veBrightnessVal" class="ve-control-value">0</span></div>
                  <input type="range" id="veBrightness" class="ve-dark-range" min="-100" max="100" step="1" value="0">
                </div>
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Contrast</span><span id="veContrastVal" class="ve-control-value">0</span></div>
                  <input type="range" id="veContrast" class="ve-dark-range" min="-100" max="100" step="1" value="0">
                </div>
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Saturation</span><span id="veSaturationVal" class="ve-control-value">0</span></div>
                  <input type="range" id="veSaturation" class="ve-dark-range" min="-100" max="100" step="1" value="0">
                </div>
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Hue</span><span id="veHueVal" class="ve-control-value">0</span></div>
                  <input type="range" id="veHue" class="ve-dark-range ve-hue-range" min="-180" max="180" step="1" value="0">
                </div>
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Blur</span><span id="veBlurVal" class="ve-control-value">0</span></div>
                  <input type="range" id="veBlur" class="ve-dark-range" min="0" max="20" step="1" value="0">
                </div>
                <button type="button" id="veAdjustReset" class="ve-reset-dark">Reset</button>
              </div>
            </div>

            <div class="ve-tab-panel" data-video-panel="audio">
              <div class="ve-control-stack">
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Volume</span><span id="veVolumeVal" class="ve-control-value">100%</span></div>
                  <input type="range" id="veVolume" class="ve-dark-range" min="0" max="100" step="1" value="100">
                </div>
                <div class="flex items-center justify-between gap-4 pt-8">
                  <span class="ve-control-head text-base">Noise reduction</span>
                  <label class="ve-toggle">
                    <input type="checkbox" id="veNoiseReduction">
                    <span class="ve-toggle-track"></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="ve-tab-panel" data-video-panel="speed">
              <div class="ve-control-stack">
                <div class="ve-control-row">
                  <div class="ve-control-head"><span>Speed</span><span id="veSpeedVal" class="ve-control-value">1</span></div>
                  <input type="range" id="veSpeed" class="ve-dark-range" min="0.5" max="2" step="0.05" value="1">
                </div>
                <div class="ve-speed-presets">
                  <button type="button" class="ve-speed-preset" data-speed="0.5">0.5</button>
                  <button type="button" class="ve-speed-preset" data-speed="0.75">0.75</button>
                  <button type="button" class="ve-speed-preset" data-speed="1.25">1.25</button>
                  <button type="button" class="ve-speed-preset" data-speed="1.5">1.5</button>
                  <button type="button" class="ve-speed-preset" data-speed="2">2</button>
                </div>
              </div>
            </div>

            <div class="hidden" aria-hidden="true">
              <span id="veTrimStartVal">0.0s</span>
              <span id="veTrimEndVal">--</span>
              <input type="range" id="veTrimStart" min="0" step="0.1" value="0">
              <input type="range" id="veTrimEnd" min="0" step="0.1" value="100">
            </div>
          </div>

          <button id="veResetBtn" class="hidden" type="button">Reset All</button>

          </div>
        </aside>

        <section class="ve-stage-pane" aria-label="Video preview">
          <div class="ve-stage-frame">
            <div class="ve-preview-frame">
              <video id="veVideoPreview" playsinline></video>
              <img id="veImagePreview" class="hidden" alt="Video editor image preview">
            </div>
            <div id="veCropGuide" class="ve-crop-guide" aria-hidden="true">
              <span class="ve-crop-handle n" data-crop-handle="n"></span>
              <span class="ve-crop-handle e" data-crop-handle="e"></span>
              <span class="ve-crop-handle s" data-crop-handle="s"></span>
              <span class="ve-crop-handle w" data-crop-handle="w"></span>
              <span class="ve-crop-handle nw" data-crop-handle="nw"></span>
              <span class="ve-crop-handle ne" data-crop-handle="ne"></span>
              <span class="ve-crop-handle se" data-crop-handle="se"></span>
              <span class="ve-crop-handle sw" data-crop-handle="sw"></span>
            </div>
            <div id="veFullscreenControls" class="ve-fullscreen-controls" aria-hidden="true">
              <div id="veFullscreenProgress" class="ve-fullscreen-progress">
                <div id="veFullscreenProgressFill" class="ve-fullscreen-progress-fill"></div>
              </div>
              <div class="ve-fullscreen-time">
                <span id="veFullscreenCurrent">0:00</span>
                <span>/</span>
                <span id="veFullscreenDuration">0:00</span>
              </div>
              <button type="button" id="veFullscreenPlay" class="ve-fullscreen-play" aria-label="Play"><i id="veFullscreenPlayIcon" class="ri-play-fill"></i></button>
              <button type="button" id="veFullscreenExit" class="ve-fullscreen-exit" aria-label="Exit fullscreen"><i class="ri-fullscreen-exit-line"></i></button>
            </div>
          </div>
        </section>
      </div>

      <div id="veTimeline" class="ve-timeline">
        <div class="ve-timeline-top">
          <div class="ve-timeline-tools">
            <button type="button" id="veSplitBtn" class="ve-tool-btn" title="Split"><i class="ri-scissors-line"></i></button>
            <button type="button" id="veMoveUpBtn" class="ve-tool-btn" title="Move up"><i class="ri-arrow-up-s-line"></i></button>
            <button type="button" id="veMoveDownBtn" class="ve-tool-btn" title="Move down"><i class="ri-arrow-down-s-line"></i></button>
            <button type="button" id="veDeleteSegmentBtn" class="ve-tool-btn" title="Delete"><i class="ri-delete-bin-line"></i></button>
            <button type="button" id="veUndoBtn" class="ve-tool-btn" title="Undo"><i class="ri-arrow-go-back-line"></i></button>
            <button type="button" id="veRedoBtn" class="ve-tool-btn" title="Redo"><i class="ri-arrow-go-forward-line"></i></button>
          </div>
          <div class="ve-transport">
            <button type="button" id="vePrevFrame" class="ve-transport-btn" title="Back"><i class="ri-skip-back-line"></i></button>
            <button type="button" id="vePlayToggle" class="ve-transport-btn play" title="Play"><i id="vePlayIcon" class="ri-play-fill"></i></button>
            <button type="button" id="veNextFrame" class="ve-transport-btn" title="Forward"><i class="ri-skip-forward-line"></i></button>
            <span class="ve-time-readout"><strong id="veCurrentTime">0:00.00</strong> / <span id="veDurationTime">0:00.00</span></span>
          </div>
          <div class="ve-timeline-zoom">
            <button type="button" id="veZoomOutBtn" class="ve-tool-btn" title="Zoom out"><i class="ri-subtract-line"></i></button>
            <button type="button" id="veZoomInBtn" class="ve-tool-btn" title="Zoom in"><i class="ri-add-line"></i></button>
            <button type="button" id="veFitTimelineBtn" class="ve-tool-btn ve-fit-screen-btn" aria-label="Fit to Screen" data-tooltip="Fit to Screen">
              <span class="ve-fit-screen-icon" aria-hidden="true">
                <i class="ri-arrow-right-line"></i><i class="ri-arrow-left-line"></i>
              </span>
            </button>
            <span class="h-8 w-px bg-[#32343b]"></span>
            <button type="button" id="veFullscreenBtn" class="ve-tool-btn" title="Full Screen"><i id="veFullscreenIcon" class="ri-fullscreen-line"></i></button>
          </div>
        </div>
        <div class="ve-timeline-body">
          <div id="veRuler" class="ve-ruler"></div>
          <div id="veTrackZone" class="ve-track-zone">
            <div id="veSegmentsLayer" class="ve-segments-layer">
              <div id="veTrimClip" class="ve-trim-clip">
                <span class="ve-trim-handle left" data-handle="start"></span>
                <div id="veThumbStrip" class="ve-thumb-strip">
                  <div class="ve-thumb-frame"></div>
                  <div class="ve-thumb-frame"></div>
                  <div class="ve-thumb-frame"></div>
                  <div class="ve-thumb-frame"></div>
                  <div class="ve-thumb-frame"></div>
                </div>
                <span class="ve-trim-handle right" data-handle="end"></span>
              </div>
            </div>
            <div id="vePlayhead" class="ve-playhead">
              <span id="vePlayheadTime" class="ve-playhead-time">0:00</span>
            </div>
            <p class="ve-empty-timeline-message">Add media to timeline to start creating video!</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div id="exportSettingsModal" class="export-modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="exportSettingsTitle">
    <div class="export-modal">
      <button type="button" id="exportSettingsClose" class="export-modal-close" aria-label="Close export settings">
        <i class="ri-close-line"></i>
      </button>
      <h2 id="exportSettingsTitle" class="export-modal-title">Export settings</h2>
      <div class="export-option-grid" role="radiogroup" aria-label="Export quality">
        <button type="button" class="export-option active" data-export-format="mp4" data-export-quality="480" data-export-width="854" data-export-height="480" role="radio" aria-checked="true">
          <strong>480p</strong>
          <span>Standard quality</span>
        </button>
        <button type="button" class="export-option" data-export-format="mp4" data-export-quality="720" data-export-width="1280" data-export-height="720" role="radio" aria-checked="false">
          <strong>720p</strong>
          <span>Standard quality, HD</span>
        </button>
        <button type="button" class="export-option" data-export-format="mp4" data-export-quality="1080" data-export-width="1920" data-export-height="1080" role="radio" aria-checked="false">
          <strong>1080p</strong>
          <span>High quality, FHD</span>
        </button>
        <button type="button" class="export-option" data-export-format="mp4" data-export-quality="2160" data-export-width="3840" data-export-height="2160" role="radio" aria-checked="false">
          <strong>2160p</strong>
          <span>High quality, 4K</span>
        </button>
        <button type="button" class="export-option export-option-wide" data-export-format="gif" data-export-quality="gif" data-export-width="854" data-export-height="480" role="radio" aria-checked="false">
          <strong>GIF</strong>
          <span>For projects up to 30 seconds</span>
        </button>
      </div>
      <button type="button" id="exportSettingsContinue" class="export-continue">Continue</button>
    </div>
  </div>

  <div id="exportProgressOverlay" class="export-progress-backdrop hidden" role="status" aria-live="polite" aria-label="Export progress">
    <div class="export-progress-content">
      <div id="exportProgressRing" class="export-progress-ring" style="--progress: 1">
        <span id="exportProgressPercent" class="export-progress-percent">1%</span>
      </div>
      <div class="export-progress-title">Exporting...</div>
      <div class="export-progress-copy">We are working on it, give us a minute!</div>
      <button type="button" id="exportCancelBtn" class="export-cancel-btn">Cancel</button>
    </div>
  </div>

  <div id="exportResultOverlay" class="export-result-backdrop hidden" aria-label="Export complete">
    <div class="export-result-layout">
      <div class="export-result-preview">
        <video id="exportResultVideo" class="hidden" playsinline controls preload="metadata"></video>
        <img id="exportResultImage" class="hidden" alt="Export preview">
        <button type="button" id="exportResultPlay" class="export-result-play" aria-label="Play exported video">
          <i class="ri-play-fill"></i>
        </button>
      </div>
      <aside class="export-result-side">
        <div>
          <h2 id="exportResultDate" class="export-result-date">29 May 2026</h2>
          <p id="exportResultMeta" class="export-result-meta">-- / MP4</p>
        </div>
        <button type="button" id="exportResultDownload" class="export-result-download">
          <i class="ri-download-line"></i>
          <span>Download</span>
        </button>
        <button type="button" id="exportResultEdit" class="export-result-action">
          <i class="ri-pencil-line"></i>
          <span>Edit</span>
        </button>
      </aside>
    </div>
  </div>


  <div id="musicEditorPanel" class="hidden">
    <div class="container mx-auto px-2 sm:px-6 lg:px-8 pt-6 pb-2">
      <div class="bg-white dark:bg-gray-800/60 dark:backdrop-blur-md border border-gray-300 dark:border-gray-600 rounded-2xl shadow-md p-4 sm:p-8 max-w-5xl mx-auto">

        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Music Editor</h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Preview &bull; Convert &bull; Export</p>
          </div>
          <button id="meCloseBtn" class="ve-btn ve-btn-secondary text-xs">Close</button>
        </div>

        <div id="meDropZone" class="ve-drop-zone">
          <input type="file" id="meFileInput" accept="audio/*,video/*" class="hidden">
          <i class="ri-upload-cloud-2-line mx-auto mb-3 text-5xl text-blue-500 block"></i>
          <p class="text-sm font-semibold text-gray-700 dark:text-gray-300">Drop your audio or video file here</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-2">or <span class="text-blue-500 underline cursor-pointer" id="meBrowseLink">click to browse</span></p>
          <p class="text-xs text-gray-400 mt-4">MP3, WAV, FLAC, AAC, M4A, OGG &bull; MP4, MOV, AVI, MKV, WebM</p>
        </div>

        <div id="meUploadProgress" class="hidden py-10 text-center">
          <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center">
            <i class="ri-upload-cloud-2-line text-4xl text-blue-500"></i>
          </div>
          <p id="meUploadFileName" class="text-base font-semibold text-gray-900 dark:text-white truncate max-w-xl mx-auto"></p>
          <p id="meUploadPercent" class="text-4xl font-extrabold text-blue-500 mt-6">21%</p>
          <div class="w-80 max-w-full h-2.5 bg-gray-200 dark:bg-gray-700 rounded-full mx-auto mt-6 overflow-hidden">
            <div id="meUploadBar" class="h-full bg-blue-500 rounded-full transition-all duration-200" style="width: 21%"></div>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-4">Uploading...</p>
        </div>

        <div id="meControls" class="hidden mt-6 space-y-6">
          <div>
            <p class="ve-section-title">Preview</p>
            <audio id="meAudioPreview" controls></audio>
            <div class="flex gap-2 mt-3">
              <button id="meChangeAudioBtn" class="ve-btn ve-btn-secondary text-xs">Change Audio</button>
              <span id="meFileName" class="text-xs text-gray-400 truncate self-center"></span>
            </div>
          </div>

          <div class="hidden">
            <input type="range" id="meTrimStart" min="0" step="0.1" value="0">
            <span id="meTrimStartVal">0.0s</span>
            <input type="range" id="meTrimEnd" min="0" step="0.1" value="100">
            <span id="meTrimEndVal">--</span>
            <input type="range" id="meVolume" min="0" max="2" step="0.1" value="1">
            <span id="meVolumeVal">1.0x</span>
          </div>

          <div class="space-y-8">
            <div>
              <div class="flex items-center gap-2 mb-5">
                <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Output Format</h3>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2">
                <button type="button" class="me-format-btn bg-blue-500 text-white" data-format="mp3">MP3</button>
                <button type="button" class="me-format-btn" data-format="aac">AAC</button>
                <button type="button" class="me-format-btn" data-format="m4a">M4A</button>
                <button type="button" class="me-format-btn" data-format="opus">Opus</button>
                <button type="button" class="me-format-btn" data-format="ogg">OGG</button>
                <button type="button" class="me-format-btn" data-format="flac">FLAC</button>
                <button type="button" class="me-format-btn" data-format="wav">WAV</button>
                <button type="button" class="me-format-btn" data-format="aiff">AIFF</button>
              </div>
            </div>

            <button type="button" id="meAdvancedToggle" class="w-full flex items-center justify-center gap-2 text-sm text-gray-600 dark:text-gray-300">
              <span>Advanced Conversion Settings</span>
              <i id="meAdvancedIcon" class="ri-arrow-up-s-line text-lg"></i>
            </button>

            <div id="meAdvancedSettings" class="space-y-5">
              <div class="bg-gray-50 dark:bg-gray-900/40 rounded-xl p-5">
                <div class="flex justify-between items-center mb-6">
                  <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Audio Settings</h3>
                </div>
                <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">Channels</p>
                <div class="grid grid-cols-3 gap-2 mb-5">
                  <button type="button" class="me-option-btn active" data-setting="channels" data-value="original">Original</button>
                  <button type="button" class="me-option-btn" data-setting="channels" data-value="mono">Mono</button>
                  <button type="button" class="me-option-btn" data-setting="channels" data-value="stereo">Stereo</button>
                </div>
                <p class="text-sm text-gray-700 dark:text-gray-300 mb-3">Sample Rate</p>
                <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
                  <button type="button" class="me-option-btn active" data-setting="sampleRate" data-value="original">Original</button>
                  <button type="button" class="me-option-btn" data-setting="sampleRate" data-value="16000">16 kHz</button>
                  <button type="button" class="me-option-btn" data-setting="sampleRate" data-value="24000">24 kHz</button>
                  <button type="button" class="me-option-btn" data-setting="sampleRate" data-value="32000">32 kHz</button>
                  <button type="button" class="me-option-btn" data-setting="sampleRate" data-value="44100">44.1 kHz</button>
                  <button type="button" class="me-option-btn" data-setting="sampleRate" data-value="48000">48 kHz</button>
                  <button type="button" class="me-option-btn" data-setting="sampleRate" data-value="96000">96 kHz</button>
                </div>
              </div>

              <div class="border border-gray-200 dark:border-gray-700 rounded-xl p-5">
                <div class="grid grid-cols-2 gap-2 mb-5">
                  <button type="button" class="me-option-btn active" data-setting="bitrateMode" data-value="cbr">CBR</button>
                  <button type="button" class="me-option-btn" data-setting="bitrateMode" data-value="vbr">VBR</button>
                </div>
                <div class="flex justify-between mb-3">
                  <label id="meBitrateLabel" class="text-xs text-gray-700 dark:text-gray-300">Bitrate</label>
                  <span id="meBitrateVal" class="text-xs font-medium text-blue-500">256 kbps</span>
                </div>
                <input type="range" id="meBitrate" class="ve-range" min="64" max="320" step="32" value="256">
              </div>

            </div>
          </div>

          <div class="pt-2">
            <div id="meStatusMsg" class="text-xs text-gray-500 dark:text-gray-400 mb-2 hidden"></div>
            <div id="meProgressBar" class="ve-progress-bar hidden">
              <div id="meProgressFill" class="ve-progress-fill"></div>
            </div>
            <div class="flex flex-col sm:flex-row justify-center gap-3 mt-4">
              <button id="meExportBtn" class="ve-btn ve-btn-primary w-full sm:w-72 justify-center">
                Convert File
              </button>
              <button id="meResetBtn" class="ve-btn ve-btn-danger w-full sm:w-auto justify-center">Reset All</button>
            </div>
            <p class="text-xs text-gray-400 mt-3 text-center">Audio processing runs entirely in your browser.</p>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- ═══════════════════════ RECORD PANEL (WebRTC Recorder) ═══════════════════════ -->
  <div id="recordPanel" class="hidden">
    <div class="container mx-auto px-2 sm:px-6 lg:px-8 pt-3 pb-2">
      <div class="bg-white border border-gray-200 rounded-lg shadow-md p-4 max-w-3xl mx-auto">
        
        <div class="flex items-center justify-between mb-3 px-1">
          <div>
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-rose-500"></span>
              </span>
              Record
            </h2>
          </div>
          <button id="recCloseBtn" class="ve-btn ve-btn-secondary text-xs">Close</button>
        </div>

        <!-- Recorder Mode Picker -->
        <div id="recSetupView" class="record-mode-shell">
          <div class="record-mode-grid">
            <button type="button" class="record-mode-card record-mode-card-audio" data-record-mode="audio" aria-label="Record audio">
              <i class="ri-voiceprint-line"></i>
              <span>Audio</span>
            </button>
            <button type="button" class="record-mode-card record-mode-card-camera" data-record-mode="camera" aria-label="Record camera">
              <i class="ri-video-line"></i>
              <span>Camera</span>
            </button>
            <button type="button" class="record-mode-card record-mode-card-screen" data-record-mode="screen" aria-label="Record screen">
              <i class="ri-mac-line"></i>
              <span>Screen</span>
            </button>
            <button type="button" class="record-mode-card record-mode-card-both" data-record-mode="both" aria-label="Record screen and camera">
              <i class="ri-picture-in-picture-line"></i>
              <span>Screen &amp; Camera</span>
            </button>
          </div>
        </div>

        <!-- Recorder Preview Screen -->
        <div id="recPreviewWrap" class="relative bg-black rounded-lg overflow-hidden aspect-[16/8.7] w-full hidden items-center justify-center border border-gray-200 group shadow-inner">
          
          <!-- Live Preview Video -->
          <video id="liveRecorderPreview" class="w-full h-full object-cover hidden" muted autoplay playsinline></video>
          
          <!-- Pip Screen Preview (for Camera + Screen both) -->
          <video id="pipRecorderPreview" class="absolute bottom-4 right-4 w-1/4 aspect-video object-cover rounded-md border-2 border-blue-500 shadow-lg hidden" muted autoplay playsinline></video>

          <!-- Recorded Video Review Player -->
          <video id="recordedVideoReview" class="w-full h-full object-contain hidden" controls></video>
          <audio id="recordedAudioReview" class="relative z-10 w-11/12 hidden" controls></audio>

          <div id="recAudioOnlyOverlay" class="record-audio-visual absolute inset-0 hidden flex-col items-center justify-center p-6 text-center text-emerald-300">
            <i class="ri-voiceprint-line text-6xl mb-3"></i>
            <p class="text-lg font-bold text-white">Audio Capture Ready</p>
            <p class="text-xs text-emerald-200/70 max-w-sm mt-1">Microphone input is active. Start recording when you are ready.</p>
          </div>

          <div id="recScreenOnlyOverlay" class="record-audio-visual absolute inset-0 hidden flex-col items-center justify-center p-6 text-center text-blue-300">
            <i class="ri-screenshot-2-line text-6xl mb-3"></i>
            <p class="text-lg font-bold text-white">Screen Capture Ready</p>
            <p class="text-xs text-blue-200/70 max-w-sm mt-1">Live screen preview is hidden to prevent repeated mirror screens. The recording will be available after you stop.</p>
          </div>

          <!-- Starting / Default State Overlay -->
          <div id="recDefaultOverlay" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-gray-900/90 text-gray-300">
            <i class="ri-record-circle-line text-6xl text-rose-500 mb-3 animate-pulse"></i>
            <p class="text-lg font-bold text-white">Preparing Capture</p>
            <p class="text-xs text-gray-400 max-w-sm mt-1 mb-4">Allow the browser permission prompt to continue.</p>
            <button type="button" id="btnInitStream" class="ve-btn ve-btn-primary px-6 py-2.5 rounded-full shadow-lg hover:scale-105 transition-all">
              <i class="ri-flashlight-line"></i> Try Again
            </button>
          </div>

          <!-- Status Indicator overlay -->
          <div id="recStatusOverlay" class="absolute top-4 left-4 bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-full text-xs font-bold text-white flex items-center gap-2 border border-white/10 hidden">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
            <span id="recStatusTxt">● STANDBY</span>
            <span class="h-3 w-px bg-white/20"></span>
            <span id="recTimer" class="font-mono">00:00</span>
          </div>
        </div>

        <!-- Recorder Toolbar controls -->
        <div id="recToolbar" class="hidden flex-wrap items-center justify-center gap-3 mt-3 pt-3 border-t border-gray-200">
          <button type="button" id="btnStartRec" class="ve-btn bg-rose-500 hover:bg-rose-600 text-white font-bold py-2.5 px-6 rounded-lg hidden">
            <i class="ri-record-circle-fill"></i> Start Recording
          </button>
          <button type="button" id="btnPauseRec" class="ve-btn bg-amber-500 hover:bg-amber-600 text-white font-bold py-2.5 px-6 rounded-lg hidden">
            <i class="ri-pause-circle-line"></i> Pause
          </button>
          <button type="button" id="btnResumeRec" class="ve-btn bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-2.5 px-6 rounded-lg hidden">
            <i class="ri-play-circle-line"></i> Resume
          </button>
          <button type="button" id="btnStopRec" class="ve-btn bg-gray-800 hover:bg-gray-900 dark:bg-gray-700 dark:hover:bg-gray-600 text-white font-bold py-2.5 px-6 rounded-lg hidden">
            <i class="ri-stop-circle-line"></i> Stop Recording
          </button>
          <button type="button" id="btnResetRec" class="ve-btn ve-btn-danger font-bold py-2.5 px-6 rounded-lg hidden">
            <i class="ri-refresh-line"></i> Discard &amp; Reset
          </button>

          <!-- Post-recording actions -->
          <div id="recPostActions" class="flex flex-wrap items-center gap-3 hidden w-full justify-center">
            <button type="button" id="btnRecImport" class="ve-btn ve-btn-primary flex-1 justify-center py-3">
              <i class="ri-music-2-line text-lg"></i> <span id="recImportLabel">Send to Audio</span>
            </button>
            <button type="button" id="btnRecDownload" class="ve-btn ve-btn-secondary flex-1 justify-center py-3">
              <i class="ri-download-2-line text-lg"></i> Download Recording
            </button>
            <button type="button" id="btnRecDiscard" class="ve-btn ve-btn-danger px-6 py-3">
              Discard
            </button>
          </div>
        </div>

        <p class="text-[11px] text-gray-500 dark:text-gray-300 mt-2 text-center leading-relaxed">
          Screen recording handles microphone/system loops entirely locally. No audio or video data leaves your computer.
        </p>

      </div>
    </div>
  </div>


  <!-- ═══════════════════════ MEDIA PANEL (Centralized Media Workspace) ═══════════════════════ -->
  <div id="mediaPanel">
    <div class="container mx-auto px-2 sm:px-6 lg:px-8 pt-3 pb-2">
      <div class="bg-white dark:bg-gray-800/60 dark:backdrop-blur-md border border-gray-300 dark:border-gray-600 rounded-2xl shadow-md p-4 sm:p-5 max-w-6xl mx-auto">
        
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2">
              <i class="ri-folder-shared-line text-blue-500"></i>
              Media Workspace
            </h2>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Central uploads library &bull; Click any asset to load it into its corresponding editor</p>
          </div>
          <button id="mediaCloseBtn" class="ve-btn ve-btn-secondary text-xs">Close</button>
        </div>

        <!-- Bulk Upload Dropzone -->
        <div id="medDropZone" class="border-2 border-dashed border-gray-300 dark:border-gray-600 hover:border-blue-500 dark:hover:border-blue-400 bg-gray-50/50 dark:bg-gray-900/30 rounded-xl p-4 cursor-pointer transition-all text-center mb-4">
          <input type="file" id="medFileInput" class="hidden" accept="image/*,audio/*" multiple />
          <div class="flex flex-col items-center">
            <i class="ri-upload-cloud-2-line text-3xl text-gray-400 mb-1"></i>
            <p class="text-base font-semibold text-gray-700 dark:text-gray-200">Drag &amp; Drop Assets or Click to Browse</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Upload multiple photos or audio tracks at once</p>
          </div>
        </div>

        <!-- Gallery/Assets Grid -->
        <div class="mb-2">
          <div class="flex items-center justify-between mb-4 pb-2 border-b border-gray-200 dark:border-gray-700/60">
            <h3 class="text-sm font-bold text-gray-800 dark:text-gray-200 tracking-wider uppercase flex items-center gap-2">
              <span class="w-1.5 h-3.5 bg-blue-500 rounded-sm"></span>
              Workspace Assets
            </h3>
            <span class="text-xs text-gray-500 dark:text-gray-400 font-medium" id="mediaCountLabel">0 assets loaded</span>
          </div>

          <div id="mediaLibraryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            <!-- Uploaded user assets will appear here dynamically -->
          </div>
        </div>

      </div>
    </div>
  </div>


  <main id="mainPhotoEditor" class="container mx-auto px-2 sm:px-6 lg:px-8 py-8 sm:py-12 hidden">
    <div class="relative bg-white dark:bg-gray-800/60 dark:backdrop-blur-md border border-gray-300 dark:border-gray-600 rounded-2xl shadow-md dark:shadow-md p-4 sm:p-8 max-w-3xl mx-auto">
      
      <!-- Main Title (as requested) -->
      <div class="text-center mb-10">
        <h1 class="text-[clamp(12px,4vw,1.875rem)] sm:text-3xl font-serif font-bold text-gray-900 dark:text-white tracking-tight leading-snug whitespace-nowrap sm:whitespace-normal">
          Create perfect <span class="italic" style="color: #c17c43;">passport photos</span> in seconds
        </h1>
      </div>

      <!-- API Key Section -->
      <div id="apiKeySection" class="mb-8 {% if server_remove_bg_key_available %}hidden{% endif %}" data-server-remove-bg-key-available="{% if server_remove_bg_key_available %}true{% else %}false{% endif %}">
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
          </svg>
          <span class="text-sm font-bold text-gray-700 dark:text-gray-300 tracking-widest uppercase">REMOVE.BG API KEY</span>
          <div class="flex-grow border-t border-gray-300 dark:border-gray-700 ml-4"></div>
        </div>
        <div class="relative">
          <input type="password" id="removeBgKey" placeholder="Paste your remove.bg API key here..." class="w-full bg-white dark:bg-gray-900/50 border border-gray-300 dark:border-gray-600 rounded-lg py-3 px-4 text-gray-800 dark:text-gray-200 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 pr-12 transition-colors" />
          <button type="button" id="toggleKeyBtn" class="absolute inset-y-0 right-0 px-4 flex items-center text-gray-400 hover:text-gray-200 focus:outline-none">
            <svg id="eyeIconOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            <svg id="eyeIconClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>
          </button>
        </div>
        <p class="text-xs text-gray-600 dark:text-gray-400 mt-3">Your key is sent directly to the server for this request and saved only in this browser on this device. <a href="https://www.remove.bg/api" target="_blank" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 font-medium">Get a free API key &rarr;</a></p>
      </div>

      <!-- Upload Section -->
      <div class="flex items-center gap-2 mb-6 mt-8">
        <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="text-sm font-bold text-gray-700 dark:text-gray-300 tracking-widest uppercase">UPLOAD PHOTOS</span>
        <div class="flex-grow border-t border-gray-300 dark:border-gray-700 ml-4"></div>
      </div>

      <!-- Drop Zone -->
      <div id="dropZone" class="border-2 border-dashed border-gray-300 dark:border-gray-600 hover:border-blue-500 dark:hover:border-blue-400 bg-transparent dark:bg-gray-900/50 rounded-xl p-8 cursor-pointer transition-all text-center">
        <input type="file" id="imageInput" class="hidden" accept="image/*" multiple />
        <div class="flex flex-col items-center">
          <svg class="w-14 h-14 text-gray-500 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-4-4V7a4 4 0 014-4h10a4 4 0 014 4v5a4 4 0 01-4 4h-2m-6 4h6m-3-4v4"/>
          </svg>
          <p class="text-lg font-semibold">Drag & Drop or Click to Upload</p>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Multiple photos supported • JPG, PNG, WEBP</p>
        </div>
      </div>

      <!-- Photo Cards List -->
      <div id="photoList" class="mt-6 space-y-3"></div>

      <!-- Add More Button (shown after first upload) -->
      <div id="addMoreWrapper" class="hidden mt-3 text-center">
        <button id="addMoreBtn" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 text-sm border border-blue-200 dark:border-blue-400/40 rounded-lg px-4 py-2 transition-all hover:bg-blue-50 dark:hover:bg-blue-400/10">
          + Add More Photos
        </button>
      </div>

      <!-- Background Color Selector -->
      <div class="mt-6 rounded-xl p-5 bg-gray-100/80 dark:bg-[#0f141e]/60 border border-gray-200 dark:border-white/10">
        <!-- Header row -->
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
            <span class="text-sm font-semibold text-slate-800 dark:text-slate-200 tracking-wide">Background Color</span>
          </div>
          <!-- Live preview badge -->
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">
            <div id="bgPreviewBox" style="width:14px;height:14px;border-radius:50%;background:#4A90D9;border:1px solid rgba(0,0,0,0.25);flex-shrink:0;"></div>
            <span id="bgColorLabel" class="text-xs text-slate-700 dark:text-slate-400 font-mono tracking-widest font-bold">#4a90d9</span>
          </div>
        </div>
        <!-- Chips row -->
        <div class="flex items-center gap-3 flex-wrap">
          <!-- Blue chip -->
          <div class="color-chip selected" id="swatch-blue" onclick="selectBg('blue','#4A90D9')">
            <div class="chip-dot" style="background:#4A90D9;"></div>
            <span class="chip-label">Blue</span>
          </div>
          <!-- White chip -->
          <div class="color-chip" id="swatch-white" onclick="selectBg('white','#ffffff')">
            <div class="chip-dot" style="background:#ffffff;"></div>
            <span class="chip-label">White</span>
          </div>

          <!-- Custom chip -->
          <label class="color-chip" id="swatch-custom" style="cursor:pointer;position:relative;">
            <div class="chip-dot" style="background:conic-gradient(red,yellow,lime,cyan,blue,magenta,red);"></div>
            <span class="chip-label">Custom</span>
            <input type="color" style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" value="#ffffff" oninput="selectBg('custom', this.value)">
          </label>
        </div>
      </div>

      <!-- Advanced Options -->
      <div class="mt-8 space-y-4">
        <div class="text-center">
          <button id="toggleAdvanced" class="text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 transition-all text-sm font-medium">Advanced Options</button>
        </div>
        <div id="advancedOptions" class="hidden bg-gray-50/80 dark:bg-gray-900/50 p-6 rounded-lg border border-gray-200 dark:border-gray-700">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
            <div>
              <label class="block mb-1 text-sm font-medium">Width (px)</label>
              <input type="number" id="width" value="390" class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <div>
              <label class="block mb-1 text-sm font-medium">Height (px)</label>
              <input type="number" id="height" value="480" class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <div>
              <label class="block mb-1 text-sm font-medium">Spacing (px)</label>
              <input type="number" id="spacing" value="10" class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <div>
              <label class="block mb-1 text-sm font-medium">Border (px)</label>
              <input type="number" id="border" value="2" class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-2 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <button id="generateBtn" class="w-full sm:w-auto bg-blue-600 text-white font-bold py-3 px-8 rounded-lg disabled:opacity-50 disabled:cursor-not-allowed">
            Generate Sheet
          </button>
          <button id="downloadBtn" class="w-full sm:w-auto bg-green-500 text-white font-bold py-3 px-8 rounded-lg hidden">
            <svg class="w-5 h-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Download PDF
          </button>
        </div>
        <div id="loading" class="hidden text-blue-600 dark:text-blue-400 font-semibold text-center">Processing images... please wait</div>
      </div>

      <embed id="pdfPreview" type="application/pdf" class="w-full h-[500px] mt-6 hidden rounded-lg"/>
    </div>
  </main>

    </main>
  </div>

  <!-- ═══════════════════════ FOOTER ═══════════════════════════════════════ -->
  <!-- Cropper Modal -->
  <div id="cropperModal" class="cropper-modal-overlay hidden">
    <div class="cropper-modal-box">
      <h3 class="text-lg font-bold mb-3 flex-shrink-0">Crop Photo</h3>
      <div class="cropper-image-area">
        <img id="cropModalImage" src="" style="max-width:100%; display:block;"/>
      </div>
      <div class="flex gap-3 mt-4 justify-end flex-shrink-0">
        <button id="cancelCropBtn" class="bg-gray-200 dark:bg-gray-600 hover:bg-gray-300 dark:hover:bg-gray-500 text-gray-800 dark:text-white py-2 px-5 rounded-lg transition-all">Cancel</button>
        <button id="confirmCropBtn" class="bg-blue-600 hover:bg-blue-700 text-white py-2 px-5 rounded-lg transition-all">Crop & Save</button>
      </div>
    </div>
  </div>

  <!-- Feedback Button -->
  <button id="feedbackBtn" class="fixed bottom-5 right-5 w-11 h-11 sm:w-[52px] sm:h-[52px] flex items-center justify-center rounded-full shadow-xl transition-all hover:scale-110 bg-slate-600 dark:bg-[#2d3139] border border-slate-500 dark:border-white/10 text-white"
    style="box-shadow: 0 4px 24px rgba(0,0,0,0.15);">
    <svg class="w-[22px] h-[22px] sm:w-[24px] sm:h-[24px]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
    </svg>
  </button>

  <!-- Feedback Modal -->
  <div id="feedbackModal" class="fixed inset-0 bg-black/50 dark:bg-black/70 flex items-center justify-center p-4 z-20 hidden">
    <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-2xl p-8 max-w-md w-full relative text-gray-900 dark:text-white">
      <button id="closeModal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-900 dark:hover:text-white text-2xl">&times;</button>
      <h2 class="text-2xl font-bold mb-4">Feedback / Bug Report</h2>
      <form id="contact-form" class="space-y-4">
        <!-- Using a placeholder access key for Web3Forms since none was provided -->
        <input type="hidden" name="access_key" value="82dbc4d8-8592-4b45-9bb1-1e736ef4c1c6">
        <input type="text" name="name" placeholder="Your Name" required class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        <input type="email" name="email" placeholder="Your Email" required class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        <select name="type" required class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-200 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 [color-scheme:light] dark:[color-scheme:dark]">
          <option value="" disabled selected hidden class="text-gray-500 dark:text-gray-400">Select Feedback Type</option>
          <option value="Bug Report" class="bg-white text-gray-900 dark:bg-gray-700 dark:text-gray-200">Bug Report</option>
          <option value="Feature Request" class="bg-white text-gray-900 dark:bg-gray-700 dark:text-gray-200">Feature Request</option>
          <option value="Question" class="bg-white text-gray-900 dark:bg-gray-700 dark:text-gray-200">Question / Other</option>
        </select>
        <textarea name="message" placeholder="Describe your issue or suggestion..." required rows="4" class="w-full bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-all">Submit</button>
      </form>
    </div>
  </div>

  <!-- Notification -->
  <div id="notification" class="fixed bottom-1/2 left-0 right-0 mx-auto w-[85%] sm:w-auto sm:mx-0 sm:left-auto sm:right-5 sm:max-w-sm text-white py-3 px-4 rounded-lg shadow-lg transform translate-x-[120%] transition-transform duration-500 z-50">
    <p id="notification-message" class="text-sm sm:text-base font-medium break-words text-center sm:text-left"></p>
  </div>


  <script>
    const serverRemoveBgKeyAvailable = document.getElementById('apiKeySection')?.dataset.serverRemoveBgKeyAvailable === 'true';


    
    // ---- Theme Toggle ----
    const themeBtn = document.getElementById('themeToggle');
    const htmlEl = document.documentElement;
    // check local storage
    if (localStorage.theme === 'dark') { htmlEl.classList.add('dark'); }
    else { htmlEl.classList.remove('dark'); }

    themeBtn.addEventListener('click', () => {
      htmlEl.classList.toggle('dark');
      if (htmlEl.classList.contains('dark')) {
        localStorage.setItem('theme', 'dark');
      } else {
        localStorage.setItem('theme', 'light');
      }
    });

    


    // ---- State ----
    // photos: Array of { id, originalFile, croppedFile, previewUrl, copies }
    let photos = [];
    let nextId = 0;
    
    // Background color selection
    window.selectedBgColor = '#4A90D9';

    function selectBg(type, color) {
      window.selectedBgColor = color;
      
      // Update preview badge
      document.getElementById('bgPreviewBox').style.background = color;
      document.getElementById('bgColorLabel').textContent = color.toLowerCase();
      
      // Reset all chips
      document.querySelectorAll('.color-chip').forEach(el => el.classList.remove('selected'));
      
      // Highlight selected chip
      const selectedChip = document.getElementById('swatch-' + type);
      if (selectedChip) selectedChip.classList.add('selected');
    }

    // Cropper modal state
    let activeCropper = null;
    let pendingCropId = null;

    // DOM refs
    const dropZone = document.getElementById('dropZone');
    const imageInput = document.getElementById('imageInput');
    const photoList = document.getElementById('photoList');
    const addMoreWrapper = document.getElementById('addMoreWrapper');
    const addMoreBtn = document.getElementById('addMoreBtn');
    const generateBtn = document.getElementById('generateBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const pdfPreview = document.getElementById('pdfPreview');
    const loading = document.getElementById('loading');
    const toggleAdvanced = document.getElementById('toggleAdvanced');
    const advancedOptions = document.getElementById('advancedOptions');
    const cropperModal = document.getElementById('cropperModal');
    const cropModalImage = document.getElementById('cropModalImage');
    const confirmCropBtn = document.getElementById('confirmCropBtn');
    const cancelCropBtn = document.getElementById('cancelCropBtn');
    const notification = document.getElementById('notification');
    const notifMsg = document.getElementById('notification-message');
    const apiKeySection = document.getElementById('apiKeySection');
    const removeBgKeyInput = document.getElementById('removeBgKey');
    const toggleKeyBtn = document.getElementById('toggleKeyBtn');
    const eyeIconOpen = document.getElementById('eyeIconOpen');
    const eyeIconClosed = document.getElementById('eyeIconClosed');
    const feedbackBtn = document.getElementById('feedbackBtn');
    const feedbackModal = document.getElementById('feedbackModal');
    const closeModal = document.getElementById('closeModal');
    const contactForm = document.getElementById('contact-form');

    // ---- Notifications ----
    function showNotification(msg, isError = true) {
      notifMsg.textContent = msg;
      notification.classList.remove('bg-red-500', 'bg-green-500');
      notification.classList.add(isError ? 'bg-red-500' : 'bg-green-500');
      notification.classList.remove('translate-x-[120%]');
      notification.classList.add('translate-x-0');
      setTimeout(() => {
        notification.classList.remove('translate-x-0');
        notification.classList.add('translate-x-[120%]');
      }, 3000);
    }

    function isApiKeySectionVisible() {
      return !apiKeySection.classList.contains('hidden');
    }

    function revealApiKeySection() {
      apiKeySection.classList.remove('hidden');
      removeBgKeyInput.focus();
    }

    if (!serverRemoveBgKeyAvailable) {
      revealApiKeySection();
    }

    const savedKey = localStorage.getItem('removeBgApiKey');
    if (savedKey) {
      removeBgKeyInput.value = savedKey;
    }

    removeBgKeyInput.addEventListener('input', (e) => {
      const value = e.target.value.trim();
      if (value) {
        localStorage.setItem('removeBgApiKey', value);
      } else {
        localStorage.removeItem('removeBgApiKey');
      }
    });

    // ---- Render Photo Cards ----
    function renderPhotoList() {
      photoList.innerHTML = '';
      photos.forEach(photo => {
        const card = document.createElement('div');
        card.className = 'photo-card flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 bg-white dark:bg-gray-900/60 border border-gray-200 dark:border-gray-700 rounded-xl p-4 shadow-sm dark:shadow-none';
        card.innerHTML = `
          <div class="flex items-center gap-4 flex-1 min-w-0">
            <img src="${photo.previewUrl}" class="w-16 h-20 object-cover rounded-lg border border-gray-200 dark:border-gray-600 flex-shrink-0" />
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 dark:text-gray-200 truncate">${photo.originalFile.name}</p>
              <p class="text-xs text-gray-500 mt-0.5">${photo.croppedFile ? '✅ Cropped' : '⚠️ Not cropped'}</p>
            </div>
          </div>
          <div class="flex items-center gap-2 sm:gap-3 w-full sm:w-auto justify-end pt-3 sm:pt-0 border-t sm:border-0 border-gray-100 dark:border-gray-800 flex-nowrap">
            <div class="flex items-center gap-1 sm:gap-2">
              <label class="hidden sm:block text-xs text-gray-600 dark:text-gray-400">Copies</label>
              <input type="number" value="${photo.copies}" min="1" max="54"
                class="bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-gray-200 rounded-lg w-16 p-1.5 text-center text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-id="${photo.id}" />
            </div>
            <button class="crop-btn text-xs bg-blue-100 hover:bg-blue-200 text-blue-600 dark:bg-blue-500/20 dark:hover:bg-blue-500/40 dark:text-blue-300 border border-blue-200 dark:border-blue-500/30 px-3 py-2 rounded-lg transition-all" data-id="${photo.id}">Crop</button>
            <button class="remove-btn text-xs bg-red-100 hover:bg-red-200 text-red-600 dark:bg-red-500/20 dark:hover:bg-red-500/40 dark:text-red-400 border border-red-200 dark:border-red-500/30 px-3 py-2 rounded-lg transition-all" data-id="${photo.id}">Remove</button>
          </div>
        `;
        photoList.appendChild(card);
      });

      // Bind copies inputs
      photoList.querySelectorAll('input[type=number]').forEach(input => {
        input.addEventListener('change', e => {
          const id = parseInt(e.target.dataset.id);
          const photo = photos.find(p => p.id === id);
          if (photo) photo.copies = Math.max(1, parseInt(e.target.value) || 1);
        });
      });

      // Bind crop buttons
      photoList.querySelectorAll('.crop-btn').forEach(btn => {
        btn.addEventListener('click', e => {
          const id = parseInt(e.target.dataset.id);
          openCropper(id);
        });
      });

      // Bind remove buttons
      photoList.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', e => {
          const id = parseInt(e.target.dataset.id);
          photos = photos.filter(p => p.id !== id);
          renderPhotoList();
          if (photos.length === 0) addMoreWrapper.classList.add('hidden');
        });
      });

      addMoreWrapper.classList.toggle('hidden', photos.length === 0);
    }

    // ---- Add Files ----
    function addFiles(files) {
      const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
      let added = 0;
      Array.from(files).forEach(file => {
        if (!validTypes.includes(file.type)) return;
        const photo = {
          id: nextId++,
          originalFile: file,
          croppedFile: null,
          previewUrl: URL.createObjectURL(file),
          copies: 6
        };
        photos.push(photo);
        added++;
      });
      if (added === 0) showNotification("Please upload valid image files (JPG, PNG, WEBP).");
      renderPhotoList();
    }

    // ---- Drop Zone ----
    dropZone.addEventListener('click', () => imageInput.click());
    dropZone.addEventListener('dragover', e => {
      e.preventDefault();
      dropZone.classList.add('border-blue-400', 'bg-gray-700/50');
    });
    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-blue-400', 'bg-gray-700/50');
    });
    dropZone.addEventListener('drop', e => {
      e.preventDefault();
      dropZone.classList.remove('border-blue-400', 'bg-gray-700/50');
      addFiles(e.dataTransfer.files);
    });
    imageInput.addEventListener('change', () => {
      addFiles(imageInput.files);
      imageInput.value = '';
    });
    addMoreBtn.addEventListener('click', () => imageInput.click());

    // ---- Cropper Modal ----
    function openCropper(id) {
      const photo = photos.find(p => p.id === id);
      if (!photo) return;
      pendingCropId = id;
      cropModalImage.src = photo.previewUrl;
      cropperModal.classList.remove('hidden');
      if (activeCropper) activeCropper.destroy();
      activeCropper = new Cropper(cropModalImage, {
        aspectRatio: 384 / 472,
        viewMode: 1,
        dragMode: 'move',
        autoCropArea: 1,
      });
    }

    confirmCropBtn.addEventListener('click', () => {
      if (!activeCropper || pendingCropId === null) return;
      const canvas = activeCropper.getCroppedCanvas({ width: 400, height: 480 });
      canvas.toBlob(blob => {
        const photo = photos.find(p => p.id === pendingCropId);
        if (!photo) return;
        photo.croppedFile = new File([blob], 'cropped-' + photo.originalFile.name, { type: 'image/png' });
        photo.previewUrl = URL.createObjectURL(blob);
        activeCropper.destroy();
        activeCropper = null;
        pendingCropId = null;
        cropperModal.classList.add('hidden');
        renderPhotoList();
        showNotification("Photo cropped successfully.", false);
      }, 'image/png');
    });

    cancelCropBtn.addEventListener('click', () => {
      if (activeCropper) { activeCropper.destroy(); activeCropper = null; }
      pendingCropId = null;
      cropperModal.classList.add('hidden');
    });

    // ---- Advanced Options ----
    toggleAdvanced.addEventListener('click', () => {
      const isHidden = advancedOptions.classList.contains('hidden');
      advancedOptions.classList.toggle('hidden');
      toggleAdvanced.textContent = isHidden ? 'Hide Advanced Options' : 'Advanced Options';
    });

    // ---- Generate PDF ----
    generateBtn.addEventListener('click', () => {
      if (photos.length === 0) {
        showNotification("Please upload at least one photo.");
        return;
      }

      const hasUncropped = photos.some(photo => !photo.croppedFile);
      if (hasUncropped) {
        showNotification("Please crop all photos before generating.", true);
        return;
      }

      const apiKey = removeBgKeyInput.value.trim();
      if (isApiKeySectionVisible() && !apiKey) {
        showNotification("Please enter your remove.bg API key.", true);
        removeBgKeyInput.focus();
        return;
      }

      const formData = new FormData();
      photos.forEach((photo, i) => {
        // Use cropped file if available, else original
        formData.append(`image_${i}`, photo.croppedFile || photo.originalFile);
        formData.append(`copies_${i}`, photo.copies);
      });
      formData.append('width', document.getElementById('width').value);
      formData.append('height', document.getElementById('height').value);
      formData.append('spacing', document.getElementById('spacing').value);
      formData.append('border', document.getElementById('border').value);
      formData.append('bg_color', window.selectedBgColor || '#ffffff');
      if (isApiKeySectionVisible() && apiKey) {
        formData.append('remove_bg_key', apiKey);
      }

      loading.classList.remove('hidden');
      generateBtn.disabled = true;
      downloadBtn.classList.add('hidden');
      pdfPreview.classList.add('hidden');

      fetch('/process', { method: 'POST', body: formData })
        .then(async response => {
          const errData = await response.clone().json().catch(() => null);
          if (errData && errData.requires_user_api_key) {
            revealApiKeySection();
            showNotification(errData.error || "Built-in remove.bg quota is finished. Enter your own remove.bg API key to continue.");
            return null;
          }
          if (response.status === 429) {
            showNotification(errData && errData.error ? errData.error : "Server Daily Quota Exceeded. Please try again later.");
            return null;
          }
          if (!response.ok) {
             throw new Error((errData && errData.error) ? errData.error : "Processing failed.");
          }
          return response.blob();
        })
        .then(blob => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);

          // Detect mobile browsers
          const isMobile = /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent);

          if (isMobile) {
            // On mobile: open PDF in new tab → device PDF viewer / Google Drive
            window.open(url, '_blank');
            showNotification("PDF ready! Opening viewer…", false);
          } else {
            // On desktop: show inline embed preview
            pdfPreview.classList.remove('hidden');
            pdfPreview.src = url;
            showNotification("PDF generated successfully!", false);
          }

          downloadBtn.classList.remove('hidden');
          downloadBtn.onclick = () => {
            const link = document.createElement('a');
            link.href = url;
            link.download = 'passport-sheet.pdf';
            link.click();
          };
        })
        .catch(err => {
          console.error(err);
          showNotification(err && err.message ? err.message : "Image processing failed. Try again later.");
        })
        .finally(() => {
          loading.classList.add('hidden');
          generateBtn.disabled = false;
        });
    });
    
    // ---- Toggle API Key Visibility ----
    toggleKeyBtn.addEventListener('click', () => {
      if (removeBgKeyInput.type === 'password') {
        removeBgKeyInput.type = 'text';
        eyeIconOpen.classList.add('hidden');
        eyeIconClosed.classList.remove('hidden');
      } else {
        removeBgKeyInput.type = 'password';
        eyeIconOpen.classList.remove('hidden');
        eyeIconClosed.classList.add('hidden');
      }
    });

    // ---- Feedback ----
    feedbackBtn.addEventListener('click', () => feedbackModal.classList.remove('hidden'));
    closeModal.addEventListener('click', () => feedbackModal.classList.add('hidden'));
    
    contactForm.addEventListener('submit', function (event) {
        event.preventDefault();

        var form = event.target;
        var formData = new FormData(form);

        if (!formData.get('name') || !formData.get('email') || !formData.get('message')) {
            showNotification('Please fill in all required fields');
            return;
        }

        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true; btn.textContent = 'Submitting...';

        fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: formData
        })
            .then(function (response) {
                if (response.ok) {
                    showNotification('Form Submitted Successfully!', false);
                    form.reset();
                    feedbackModal.classList.add('hidden');
                } else {
                    return response.json().then(function (data) {
                        throw new Error(data.message || 'Form Submission Failed!');
                    });
                }
            })
            .catch(function (error) {
                showNotification('Form Submission Failed! Error: ' + error.message);
            })
            .finally(() => {
                btn.disabled = false; btn.textContent = 'Submit';
            });
    });
  </script>

