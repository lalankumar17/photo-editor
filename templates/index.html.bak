    const exportSettingsModal = document.getElementById('exportSettingsModal');
    const exportSettingsClose = document.getElementById('exportSettingsClose');
    const exportSettingsContinue = document.getElementById('exportSettingsContinue');
    const exportOptionBtns = document.querySelectorAll('.export-option');
